# ScamShield Nepal - Environment Variables Template
# Copy this file to .env.local for local overrides. Do NOT commit secrets.

# FastAPI origin (root path, without /api/v1); configure the deployed backend in Vercel.
VITE_API_BASE_URL=http://localhost:8000

# Set true only when intentionally using the local rule-based demo without a backend.
VITE_DEMO_MODE=false
