# Copy to .env and export these values before starting the API or running Alembic.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./scamshield.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=15
SCAN_RETENTION_DAYS=90
OCR_LANGUAGES=eng

# Exact deployed frontend origin(s); comma-separated for multiple environments.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password-reset email delivery is not configured by this implementation.
